# Airwallex — Developer → API keys in your Airwallex account.
# Use sandbox keys with 'demo'; switch to live keys and 'prod' when you launch.
NUXT_AIRWALLEX_CLIENT_ID=
NUXT_AIRWALLEX_API_KEY=
NUXT_PUBLIC_AIRWALLEX_ENV=demo

# Your site's public HTTPS address, e.g. https://peel.example. Airwallex's
# checkout loads any image given as a path under public/ from it. Leave empty
# to use the address the site is served from.
NUXT_PUBLIC_SITE_URL=

# Ad pixels: each optional, and nothing loads until it's set. They're public
# IDs, not secrets.
#
# Meta Pixel: Meta Events Manager → Connect data → Web → your dataset's ID
# (digits only, e.g. 1234567890123456).
NUXT_PUBLIC_META_PIXEL_ID=
#
# Google tag: the tag ID from Google Ads (AW-…) or Google Analytics (G-…).
# For both, separate them with a comma: G-ABC123XYZ,AW-123456789
NUXT_PUBLIC_GOOGLE_TAG_ID=
#
# Google Ads purchase conversion: Goals → Conversions → your Purchase action →
# Tag setup → "Use Google tag" → the send_to value, e.g. AW-123456789/AbCdEfGhIjK.
# With this set, the AW- tag above can be left out.
NUXT_PUBLIC_GOOGLE_ADS_CONVERSION=
